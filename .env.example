# 3D Studio AI — frontend configuration example.
#
# Copy to `.env.local` for local development. NEVER commit a real `.env`.
# Every VITE_* value is inlined into the bundle at BUILD time; changing it at
# runtime has no effect until a new build is produced.

# Backend base URL. Empty means "same origin" (the Vite dev proxy / production
# host serves both). Not a secret.
VITE_API_BASE_URL=

# W14: assemblies. Off unless the exact value "true".
VITE_ASSEMBLY_ENABLED=false

# W15.10: AI scene editing (the "AI bilan tahrirlash" panel). Off unless the
# exact value "true". Any other value — "false", "0", "1", "yes", empty, or the
# variable being unset — keeps the panel hidden.
VITE_AI_EDIT_ENABLED=false
