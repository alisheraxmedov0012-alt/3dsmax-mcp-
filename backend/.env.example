# 3D Studio AI — backend configuration example.
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
# All values here are NON-SECRET placeholders.

# --- Core ---
APP_ENVIRONMENT=development          # development | test | production
APP_DEBUG=false

# --- Database ---
# Local development default (SQLite file):
APP_DATABASE_URL=sqlite:///./3dstudio.db
# Production (PostgreSQL). Provide via the server environment, not in git:
# APP_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/3dstudio

# --- Session / cookies ---
# Generate a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=change-me-to-a-long-random-value
APP_SESSION_TTL_SECONDS=604800
APP_COOKIE_NAME=session
APP_COOKIE_SECURE=false              # MUST be true in production (HTTPS)
APP_COOKIE_SAMESITE=lax
# APP_COOKIE_DOMAIN=.example.com

# --- CORS: comma-separated frontend origins ---
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
# "memory" = per-process only (fine for a single worker local/staging).
# "redis"  = shared across workers; requires APP_REDIS_URL. If the Redis store
#            is unreachable the limiter fails CLOSED (refuses requests).
APP_RATE_LIMIT_ATTEMPTS=10
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_BACKEND=memory
# APP_REDIS_URL=redis://localhost:6379/0
# W11: tighter per-scope budgets, e.g. "login=5,ai=3,files=30". Any scope not
# listed keeps its built-in default (login/register/… are tighter than the global).
# APP_RATE_LIMIT_SCOPES=login=5,register=3
# W11: only trust X-Forwarded-For behind a reverse proxy you control. The client
# IP is otherwise taken from the socket peer, so it cannot be spoofed.
APP_TRUST_FORWARDED_FOR=false
APP_TRUSTED_PROXY_COUNT=1
# W11: max size for non-multipart request bodies (bytes); uploads use the
# storage cap instead.
APP_MAX_REQUEST_BYTES=1048576

# --- Logging / observability ---
APP_LOG_FORMAT=json            # json | text
# Optional error tracking. Leave empty to disable (it is never faked as active).
# APP_ERROR_TRACKING_DSN=https://<key>@<host>/<project>
APP_ERROR_TRACKING_SAMPLE_RATE=0.0

# --- Email ---
# "console" logs the message and does NOT deliver it (development/test only).
# Configure "smtp" for real delivery.
# W12: production requires APP_EMAIL_BACKEND=smtp — the console adapter is
# refused at startup because verification/reset mail would never be delivered.
APP_EMAIL_BACKEND=console
# APP_EMAIL_BACKEND=smtp
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=587
# APP_SMTP_USER=apikey
# APP_SMTP_PASSWORD=replace-me
APP_EMAIL_FROM=no-reply@example.invalid
# Expose verification/reset tokens in API responses for local testing ONLY.
APP_EXPOSE_DEV_TOKENS=true

# --- Payments (SANDBOX ONLY) ---
# "fake" enables the clearly-labelled sandbox adapter. No real provider is
# selected and no real keys are used. Unconfigured providers report as such.
# W12: production refuses sandbox provider names — a real provider must be
# configured (or paid plans disabled) so entitlements are never granted for free.
APP_PAYMENT_PROVIDER=fake
APP_PAYMENT_WEBHOOK_SECRET=local-sandbox-webhook-secret

# --- Job queue (W10) ---
# "inline" executes jobs in the request (development/test only).
# "worker" requires a separate worker process and is mandatory in production.
APP_JOB_BACKEND=inline
APP_JOB_MAX_ATTEMPTS=3
APP_JOB_TIMEOUT_SECONDS=300
APP_JOB_MAX_PAYLOAD_BYTES=65536
# W11: cap on jobs a single user may run in parallel.
APP_JOB_MAX_PARALLEL_PER_USER=3
# W11: a worker heartbeat older than this makes readiness report "not ready".
APP_WORKER_HEARTBEAT_TTL_SECONDS=60

# --- File storage (W10) ---
# "memory"  - in-process, test/development only (not persistent).
# "local"   - writes under APP_STORAGE_DIR (single-node deployment).
# "s3"      - documented boundary, NOT implemented; selecting it is reported as
#             unconfigured and blocks production startup.
APP_STORAGE_BACKEND=memory
APP_STORAGE_DIR=./var/storage
APP_STORAGE_MAX_BYTES=26214400
APP_STORAGE_MAX_PROJECT_BYTES=209715200

# --- AI design provider (W1) ---
# "none"      - default; the API reports the integration as unconfigured and the
#               frontend uses the offline local analyzer.
# "local"     - offline, deterministic, credential-free analyzer (no network).
# "openai_compatible" - any OpenAI-compatible /chat/completions API.
APP_AI_PROVIDER=none
# Real provider settings (server-side only; NEVER commit real values):
# APP_AI_API_KEY=sk-...            # required for openai_compatible
# APP_AI_BASE_URL=https://api.openai.com/v1
# APP_AI_MODEL=gpt-4o-mini
APP_AI_TIMEOUT_SECONDS=20
APP_AI_MAX_RETRIES=1
# System-wide ceiling on AI provider calls per UTC day, across all users. This is
# an abuse/cost guard, not a plan limit: it bounds the bill when a plan limit is
# unset or an account misbehaves. 0 disables it. A conservative starting value.
APP_AI_GLOBAL_DAILY_LIMIT=200

# --- Frontend (Vite) ---
# Base URL of this backend, used by the SPA.
VITE_API_BASE_URL=http://localhost:8000
